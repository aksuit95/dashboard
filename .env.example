DART_API_KEY=
# 토스증권 Open API (서버 전용)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# KRX 공식 Open API 시세용. 인증키 발급 외에 5개 시세 API 각각 이용 승인이 필요합니다.
# 투자자별 거래실적은 공식 Open API 미제공 항목입니다.
KRX_API_KEY=
# 수급분석: KRX 정보데이터시스템 자체 계정 (서버 전용, NEXT_PUBLIC_ 금지)
KRX_ID=
KRX_PW=
DATABASE_URL=file:./data/market.sqlite
POLL_INTERVAL_MS=20000
DEFAULT_FX_PAIR=USDKRW
# Vercel Production 환경에 임의의 긴 비밀값으로 설정 (예약 수집 인증)
CRON_SECRET=
# valuation:export 전용 로컬 엑셀 경로. Vercel에는 설정하지 않습니다.
VALUATION_WORKBOOK_PATH=
